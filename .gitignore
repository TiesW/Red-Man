# Ignore everything in the root by default, and only whitelist what's needed to open the project from a fresh clone.
# (Library, Temp, Logs, obj, build, UserSettings, generated .csproj/.sln files etc. are all regenerated by Unity/the IDE)
/*
/*/

# Root files
!.gitignore

# Root folders
!/Assets/
!/ProjectSettings/
!/Packages/

# Junk inside the whitelisted folders
.DS_Store
Thumbs.db
desktop.ini
.vs/
/Assets/_Recovery/
/Assets/_Recovery.meta
